<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="main w-full min-h-screen bg-zinc-900 text-white py-4 px-2">
        <form action="/edit" method="post">
            <a class="text-blue-500 px-3" href="/">Go to home</a>
            <div class="mt-5">
            <input class="text-white block px-5 py-2 bg-zinc-800 w-70 rounded-md outline-none  " type="text" placeholder="Previous content" name="previouss" value="" >
            <input class=" block text-white px-5 py-2 bg-zinc-800 resize-none w-70 rounded-md outline-none mt-3" type="text" placeholder="New content" name="news" value="<%=filenames%>">
            </div>
            <!-- <input class="bg-white" type="submit" value="create task"> -->
            <button class="bg-yellow-600 px-5 py-2 rounded-md mt-3 ">Update</button>
        </form>
        </div>
</body>
</html>