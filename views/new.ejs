<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <title>Document</title>
</head>
<body>
<div class="main w-full min-h-screen bg-zinc-900">
    <div class="form  p-10">
        <form action="/create" method="post">
            <input class="text-white block px-5 py-2 bg-zinc-800 w-full rounded-md outline-none" type="text" placeholder="type here" name="tittle">
            <textarea class=" block text-white px-5 py-2 bg-zinc-800 mt-2 resize-none w-full rounded-md outline-none" type="text" placeholder="write your task details" name="details"></textarea>
            <!-- <input class="bg-white" type="submit" value="create task"> -->
            <button class="bg-blue-600 px-5 py-2 mt-2 rounded-md ">create task</button>
        </form>
        <div class="task py-10 flex gap-3 flex-wrap">
            <% if(files.length>0){ %>
                <% files.forEach(function(val){ %>
                    <div class="task w-72  px-3 py-4 bg-zinc-800 rounded-md ">
                        <h1 class="text-white tracking-tight text-3xl"><%=val %></h1>
                        <div class="justify-between ">
                        <a class="text-blue-500 inline-block mt-3" href="/files/<%= val %>">Read More</a>
            
                        <a class="text-green-600 ml-38" href="/edit/<%= val %>">Edit</a>
                        
                        <a class="text-green-600 ml-38" href="/edit/<%= val %>">Content Edit</a>
                        </div>
                       </div>
                    <%  }) %>
           <% } else{ %>
            <h1 class="text-white">No task yet.</h1>
          <% } %>
          
    
